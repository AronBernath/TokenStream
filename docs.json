{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "linden",
  "name": "TokenStream",
  "description": "Open-source AI orchestration runtime for governed model access, MCP tool use, RAG, ingestion, and source-backed context.",
  "colors": {
    "primary": "#0891b2",
    "light": "#22d3ee",
    "dark": "#0f172a"
  },
  "logo": {
    "light": "/logo-light.svg",
    "dark": "/logo-dark.svg",
    "href": "https://tokenstream.mintlify.site"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "family": "Inter",
    "heading": {
      "family": "Inter",
      "weight": 700
    },
    "body": {
      "family": "Inter",
      "weight": 450
    }
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "grid"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/AronBernath/TokenStream"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Quickstart",
      "href": "/quickstart"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode"
    ]
  },
  "navigation": {
    "groups": [
      {
        "group": "Start Here",
        "pages": [
          "overview/what-is-tokenstream",
          "overview/behind-your-application"
        ]
      },
      {
        "group": "Getting Started",
        "pages": [
          "quickstart/index",
          "quickstart/configure-access"
        ]
      },
      {
        "group": "Core Concepts",
        "pages": [
          "concepts/core-concepts",
          "concepts/policies-and-model-access",
          "concepts/retrieval-and-source-backed-context"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/connect-a-client-application",
          "guides/use-retrieval-in-a-workflow",
          "guides/ingest-and-reingest-sources",
          "guides/operate-tokenstream"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/api-reference",
          "reference/configuration-reference"
        ]
      },
      {
        "group": "Troubleshooting",
        "pages": [
          "troubleshooting/index"
        ]
      },
      {
        "group": "Review Notes",
        "pages": [
          "review/limits-and-evidence-gaps"
        ]
      }
    ]
  }
}
